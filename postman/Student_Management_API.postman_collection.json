{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Add student (POST) - expect 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
        }
      }
    },
    {
      "name": "1b. Add second student (POST) - expect 201",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Singh\",\n  \"email\": \"priya@example.com\",\n  \"course\": \"Mechanical Engineering\",\n  \"age\": 21\n}"
        }
      }
    },
    {
      "name": "2. Get all students (GET) - expect 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "3. Get student by ID (GET) - expect 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        }
      }
    },
    {
      "name": "4. Update student (PUT) - expect 200",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/students/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "1"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Data Science\",\n  \"age\": 21\n}"
        }
      }
    },
    {
      "name": "5. Get students by course (GET) - expect 200",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/course/Data Science",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "course",
            "Data Science"
          ]
        }
      }
    },
    {
      "name": "6. Delete student (DELETE) - expect 200",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/students/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "2"
          ]
        }
      }
    },
    {
      "name": "ERR-A. Student not found (GET) - expect 404",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "999"
          ]
        }
      }
    },
    {
      "name": "ERR-B. Validation failure (POST) - expect 400",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"course\": \"\",\n  \"age\": -5\n}"
        }
      }
    },
    {
      "name": "ERR-C. Duplicate email (POST) - expect 409",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Another Person\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Physics\",\n  \"age\": 22\n}"
        }
      }
    }
  ]
}